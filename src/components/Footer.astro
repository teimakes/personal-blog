---
import { SITE } from '../config';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="site-footer">
  <div class="container">
    <nav class="social-links" aria-label="Social profiles">
      {Object.entries(SITE.social).map(([label, href]) => <a href={href} rel="me">{label}</a>)}
    </nav>
    <div class="footer-inner">
      <p>© {new Date().getFullYear()} {SITE.author}. All rights reserved.</p>
      <nav class="footer-nav" aria-label="Site links">
        <a href={`${base}/rss.xml`}>RSS</a>
        <a href={`${base}/feed.json`}>JSON</a>
        <a href={`${base}/privacy`}>Privacy</a>
      </nav>
    </div>
  </div>
</footer>
