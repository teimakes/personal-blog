---
import { SITE } from '../config';
const { pathname } = Astro.url;
const isActive = (href: string) => (href === '/' ? pathname === '/' : pathname.startsWith(href));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<header class="site-header">
  <div class="container header-inner">
    <a href={`${base}/`} class="logo">
      <img src={`${base}/teimakes-mark.png`} class="brand-mark" width="40" height="40" alt="" />
      <span>{SITE.title}</span>
    </a>
    <nav class="nav">
      <a href={`${base}/`} class:list={[{ active: isActive('/') }]}>Blog</a>
      <a href={`${base}/about`} class:list={[{ active: isActive('/about') }]}>About</a>
      <a href={`${base}/links/`} class:list={[{ active: isActive('/links') }]}>Links</a>
      <a href={`${base}/subscribe`} class:list={[{ active: isActive('/subscribe') }]}>Subscribe</a>
    </nav>
  </div>
</header>
